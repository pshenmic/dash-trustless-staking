{
  "name": "dash-trustless-staking-web",
  "private": true,
  "version": "2.0.0",
  "description": "Frontend for coordinating Dash shared masternodes through Dash Platform",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pshenmic/dash-trustless-staking.git"
  },
  "author": "pshenmic",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "identity": "node scripts/identity.mjs",
    "test:contract": "node scripts/test-contract.mjs",
    "deploy:contract": "node scripts/deploy-contract.mjs",
    "test:live": "esbuild scripts/test-live.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.test-live.mjs --log-level=error && VITE_CONTRACT_ID=$(grep VITE_CONTRACT_ID .env | cut -d= -f2) node scripts/.test-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-query": "^5.104.0",
    "cbor2": "^2.4.1",
    "country-flag-icons": "^1.6.20",
    "dash-core-sdk": "1.1.5",
    "dash-platform-sdk": "1.6.1",
    "dash-ui-kit": "^2.1.5",
    "pshenmic-dpp": "2.0.1-dev.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.1.0"
  }
}
