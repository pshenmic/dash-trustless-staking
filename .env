# Registration transaction fee, in DASH, written into every new pool and split between its members.
# Stored in each pool document, so changing it only affects pools created afterwards.
VITE_REGISTRATION_FEE=0.0002

# The staking data contract (schema.json in the repo root) on testnet.
VITE_CONTRACT_ID=5BrN2ssGNNAZPgA1wu8TCpdZr5Fb8BrQXpaHUVWJSr3z

# Default data source: 'testnet' (real Platform documents) or 'mock' (an empty in-browser sandbox for
# trying the whole flow, including registration). Settings can override it per browser.
VITE_BACKEND=testnet
